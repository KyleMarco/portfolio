{
  "name": "portfolio-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:portfolio": "turbo run dev --filter=@portfolio/site",
    "dev:storefront": "turbo run dev --filter=@portfolio/storefront",
    "dev:storybook": "turbo run dev --filter=@portfolio/storybook",
    "build": "turbo run build",
    "build:portfolio": "turbo run build --filter=@portfolio/site",
    "build:storefront": "turbo run build --filter=@portfolio/storefront",
    "build:storybook": "turbo run build --filter=@portfolio/storybook",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "test": "turbo run test",
    "test:portfolio": "turbo run test --filter=@portfolio/site",
    "test:storefront": "turbo run test --filter=@portfolio/storefront",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "preview": "turbo run preview --filter=@portfolio/site",
    "preview:storefront": "turbo run preview --filter=@portfolio/storefront"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10"
  }
}
