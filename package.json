{
  "name": "portfolio-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:portfolio",
    "dev:portfolio": "npm run dev --workspace=@portfolio/site",
    "dev:storefront": "npm run dev --workspace=@portfolio/storefront",
    "build": "npm run build:apps && node scripts/assemble-site.mjs",
    "build:apps": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint .",
    "test": "npm run test --workspaces --if-present && node --test scripts/assemble-site.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "preview": "npm run preview --workspace=@portfolio/site -- --outDir ../../dist",
    "preview:storefront": "npm run preview --workspace=@portfolio/storefront"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.6.2"
  }
}
