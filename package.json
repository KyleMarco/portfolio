{
  "name": "portfolio-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:portfolio",
    "dev:portfolio": "turbo run dev --filter=@portfolio/site",
    "dev:storefront": "turbo run dev --filter=@portfolio/storefront",
    "build": "npm run build:apps && node scripts/assemble-site.mjs",
    "build:apps": "turbo run build --filter=@portfolio/site --filter=@portfolio/storefront",
    "typecheck": "turbo run typecheck --filter=@portfolio/site --filter=@portfolio/storefront",
    "lint": "oxlint .",
    "test": "turbo run test --filter=@portfolio/site --filter=@portfolio/storefront && node --test scripts/assemble-site.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "preview": "turbo run preview --filter=@portfolio/site -- --outDir ../../dist",
    "preview:storefront": "turbo run preview --filter=@portfolio/storefront"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10"
  }
}
